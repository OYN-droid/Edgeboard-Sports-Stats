# Runtime mode: sample remains the safe default. Use live only after implementing and verifying an adapter.
EDGEBOARD_PROVIDER_MODE=sample
EDGEBOARD_PROVIDER_NAME=edgeboard-mock
EDGEBOARD_PROVIDER_BASE_URL=
EDGEBOARD_PROVIDER_API_KEY=
EDGEBOARD_PROVIDER_API_KEY_HEADER=Authorization

# Provider resilience
EDGEBOARD_REQUEST_TIMEOUT_SECONDS=5
EDGEBOARD_MAX_RETRIES=2
EDGEBOARD_RETRY_BASE_SECONDS=0.25
EDGEBOARD_CACHE_TTL_SECONDS=60
EDGEBOARD_CACHE_STALE_SECONDS=3600

# Local gateway server
EDGEBOARD_SERVER_HOST=127.0.0.1
EDGEBOARD_SERVER_PORT=9010
