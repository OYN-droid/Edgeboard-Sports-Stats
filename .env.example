# Application
# Canonical application names (legacy APP_ENV, DATA_MODE, and LOG_LEVEL remain aliases)
EDGEBOARD_ENV=development
EDGEBOARD_DATA_MODE=sample
EDGEBOARD_DEFAULT_PROVIDER=
EDGEBOARD_DEFAULT_ODDS_PROVIDER=
EDGEBOARD_LOG_LEVEL=INFO
EDGEBOARD_VERSION=1.6
APP_BASE_URL=http://127.0.0.1:9010
API_BASE_URL=/api
SAMPLE_MODE=true
ALLOWED_ORIGINS=http://127.0.0.1:9010,http://localhost:9010
REQUEST_BODY_LIMIT_BYTES=262144

# Primary sports provider (SERVER ONLY; leave empty in sample/fixture mode)
SPORTS_PROVIDER_ID=
SPORTS_PROVIDER_BASE_URL=
SPORTS_PROVIDER_API_KEY=
SPORTS_PROVIDER_API_KEY_HEADER=Authorization
SPORTS_PROVIDER_ACCOUNT_ID=

# Primary odds provider (SERVER ONLY; optional until a provider ticket certifies it)
ODDS_PROVIDER_ID=
ODDS_PROVIDER_BASE_URL=
ODDS_PROVIDER_API_KEY=
ODDS_PROVIDER_REGIONS=
ODDS_PROVIDER_BOOKS=

# Secondary providers (SERVER ONLY; all fields in a configured group are required together)
SECONDARY_SPORTS_PROVIDER_ID=
SECONDARY_SPORTS_PROVIDER_BASE_URL=
SECONDARY_SPORTS_PROVIDER_API_KEY=
SECONDARY_ODDS_PROVIDER_NAME=
SECONDARY_ODDS_PROVIDER_BASE_URL=
SECONDARY_ODDS_PROVIDER_API_KEY=

# Provider resilience
PROVIDER_REQUEST_TIMEOUT_SECONDS=5
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_SECONDS=0.25
PROVIDER_CONCURRENCY=4
SPORTS_PROVIDER_POC_ENABLED=false
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30

# Cache and database
DATABASE_URL=sqlite:///:memory:
CACHE_URL=
WORKER_QUEUE_URL=
SECRET_MANAGER_REFERENCE=
CACHE_TTL_DEFAULT=60
CACHE_TTL_LIVE=8
# Ticket 9 remains opt-in. This switch never starts a background loop; it only
# permits explicit, bounded admin/development poll requests.
MLB_LIVE_POLLING_ENABLED=false
MLB_LIVE_POLL_REQUEST_BUDGET=20
MLB_LIVE_FINAL_CORRECTION_SECONDS=900
SPORTS_PROVIDER_KILL_SWITCH=false
MLB_KILL_SWITCH=false
MLB_MARKET_DATA_KILL_SWITCH=false
MLB_LIVE_EVENT_KILL_SWITCH=false
# Comma-separated fine-grained Ticket 10 domain IDs, for example: player_props,live_score
MLB_DOMAIN_KILL_SWITCHES=
# Internal operational warning thresholds. They do not certify or promote domains.
MLB_CERT_FAILURE_RATE_ALERT=0.20
MLB_CERT_STALE_RATE_ALERT=0.25
MLB_CERT_REJECTION_RATE_ALERT=0.10
MLB_CERT_RATE_LIMIT_ALERT=0.10
MLB_CERT_MAPPING_FAILURE_ALERT=5
MLB_CERT_POLLING_BUDGET_ALERT=2
MLB_CERT_CORRECTION_SPIKE_ALERT=10
MLB_CERT_SHADOW_DISCREPANCY_ALERT=25
CACHE_STALE_SECONDS=3600

# Optional authentication
AUTH_SECRET=
AUTH_ISSUER=edgeboard
AUTH_AUDIENCE=edgeboard-web

# Observability and protected diagnostics
ERROR_REPORTING_DSN=
METRICS_ENABLED=true
ADMIN_TOKEN=

# Public feature flags (not secret storage)
LIVE_DATA_ENABLED=false
LIVE_ODDS_ENABLED=false
HISTORICAL_STATS_ENABLED=false
INJURIES_ENABLED=false
LINEUPS_ENABLED=false
CLOUD_WORKSPACE_SYNC_ENABLED=false
SERVER_ALERTS_ENABLED=false
AI_EXPLANATIONS_ENABLED=false
VISUAL_TELEMETRY_ENABLED=false
SAMPLE_MODE_ENABLED=true
LEAGUE_ROLLOUT_ENABLED=true
COVERAGE_PAGE_ENABLED=true

# League-specific rollout states. Live-capable states require verified server credentials.
MLB_ROLLOUT_STATE=fixture_only
WNBA_ROLLOUT_STATE=fixture_only
UFC_ROLLOUT_STATE=fixture_only
MLS_ROLLOUT_STATE=fixture_only

# Provider terms and retention controls
PROVIDER_ATTRIBUTION_REQUIRED=true
PROVIDER_RAW_RETENTION_ALLOWED=false
PROVIDER_NORMALIZED_RETENTION_ALLOWED=true
PROVIDER_ODDS_HISTORY_ALLOWED=false
PROVIDER_PUBLIC_REDISTRIBUTION_ALLOWED=false
PROVIDER_LOGO_USE_ALLOWED=false
PROVIDER_MEDIA_USE_ALLOWED=false
PROVIDER_MAX_CACHE_SECONDS=3600

# Ticket 7 normalized movement controls. This is bounded process memory unless
# explicit provider terms authorize historical storage.
MARKET_MOVEMENT_MAX_SNAPSHOTS=10000
MARKET_MOVEMENT_LINE_THRESHOLD=0.5
MARKET_MOVEMENT_IMPLIED_PROBABILITY_THRESHOLD=0.02

# Protected diagnostic foundations (never part of public browser configuration)
PROVIDER_DIAGNOSTICS_ENABLED=false
PROVIDER_HEALTH_ENABLED=false
DATA_QUALITY_LOGGING_ENABLED=true

# Usage warnings (counts per rolling monitoring window; pricing is never public)
PROVIDER_REQUEST_WARNING_PER_HOUR=5000
PROVIDER_RETRY_WARNING_PER_HOUR=250
PROVIDER_EXPENSIVE_WARNING_PER_HOUR=100

# Server
EDGEBOARD_SERVER_HOST=127.0.0.1
EDGEBOARD_SERVER_PORT=9010

# EDGEBOARD_DATA_MODE=fixture uses deterministic recorded fixtures without credentials.
# Live mode is intentionally unavailable until a provider POC is implemented and explicitly certified.
# SportsDataIO MLB trial: set SPORTS_PROVIDER_ID=sportsdataio and SPORTS_PROVIDER_API_KEY.
# Its official base URL and Ocp-Apim-Subscription-Key header are selected server-side automatically.
# Set MLB_ROLLOUT_STATE=shadow only when running the protected validation workflow.
# Also set SPORTS_PROVIDER_POC_ENABLED=true for that explicit opt-in process.
# Discovery Lab responses never become user-facing primary data; fixtures remain primary on failure.
# Ticket 4 uses the same opt-in flags for protected MLB standings and season-aggregate validation.
# No additional credential is required and no Ticket 4 setting enables public live data.
# Ticket 5 uses the same server-only key for protected MLB pregame-odds shadow validation.
# Ticket 5 does not enable live odds, public provider data, or Certified Live.
# Ticket 6 reuses the same key for protected Betting Player Props by Game shadow validation.
# Prop candidates remain scrambled/sample, fixture-primary, and never Certified Live.
# Ticket 9 reuses the key only for an explicit, bounded BoxScoresByDate shadow check.
# Keep MLB_LIVE_POLLING_ENABLED=false unless running a protected development validation;
# no browser, startup, or background polling is enabled by these settings.
